# Portfolio monorepo
# Copy to `.env` in this directory. Next.js loads it via `web/next.config.ts` envDir.

# --- Site (Next.js) ---
# Kratko ime na sajtu (npr. NBW = New Blue Wood)
NEXT_PUBLIC_DISPLAY_NAME=New Blue Wood
# Optional public site URL (absolute links in CV PDF export; Vercel sets VERCEL_URL automatically)
# NEXT_PUBLIC_SITE_URL=https://my-portfolio-newbluewoods-projects.vercel.app

# Optional public GitHub profile URL (hero + contact + infers server-side username for Projects when GITHUB_USERNAME unset)
NEXT_PUBLIC_GITHUB_URL=

# Optional — overrides only the “Applying for” line on /cv (JSON stays in content/cv.json)
# CV_HEADLINE_APPLYING_FOR=Senior Frontend Engineer (remote)

# GitHub API (server-side, Next.js projects page)
# Your GitHub login — if omitted, code uses NEXT_PUBLIC_GITHUB_URL (profile URL) to infer it when set
GITHUB_USERNAME=your-github-username
# Preporuka na produkciji: Projects strana za repoe bez „Website” u About-u povlači README (GET /readme); token smanjuje rizik od rate limita.
# Optional — higher rate limits + lists private repos you own (classic PAT: repo scope)
GITHUB_TOKEN=

# Show fork and/or archived repos on Projects + include them in README ingest (default: omit)
# GITHUB_REPOS_INCLUDE_FORKS=1
# GITHUB_REPOS_INCLUDE_ARCHIVED=1

# README live-URL fallback (Projects / Lab build): koliko najnovijih repoa bez „Website” da se čita README; konkurentnost za GitHub
# README_LIVE_URL_MAX=24
# README_LIVE_URL_CONCURRENCY=4

# BFF proxy target for the assistant (mora da odgovara portu na kom lokalno radiš uvicorn — u root `npm run dev:api` koristi 8020)
PORTFOLIO_API_URL=http://127.0.0.1:8020

# Opciono — `npm run dev:full` / `workflow:reset`: čekanje (ms) pre drugog doctor u trećoj concurrently traci (`doc`); default 14000
# POST_DEV_DOCTOR_DELAY_MS=14000

# --- Python API (LlamaIndex + FastAPI) ---
# Gemini / Google GenAI (required for ingest + chat)
GOOGLE_API_KEY=
# or: GEMINI_API_KEY=

# Optional — reserved for future tools (chat uses RAG-only Condense+Context engine today)
TAVILY_API_KEY=

# Ingest: README fetch (defaults match GITHUB_USERNAME above)
# GITHUB_USERNAME=
# GITHUB_TOKEN=
# Max repos to pull into RAG per ingest after fork/archived filters (1–100, default 50)
# GITHUB_INGEST_MAX_REPOS=50
# GITHUB_REPOS_INCLUDE_FORKS=1
# GITHUB_REPOS_INCLUDE_ARCHIVED=1

# Optional overrides (free tier: prefer flash-lite if 2.0-flash hits rate limits)
# GEMINI_MODEL=models/gemini-2.5-flash-lite
# Embedding model for RAG (embedContent). See:
# https://ai.google.dev/gemini-api/docs/embeddings
# Stable text-only: gemini-embedding-001 | Newer multimodal: gemini-embedding-2
# List models that support embedContent: https://ai.google.dev/api/rest/v1beta/models
# GEMINI_EMBED_MODEL=gemini-embedding-001
# CHROMA_PATH=../data/chroma
# CHROMA_COLLECTION=portfolio_kb
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Na produkciji API (Docker): npr. CORS_ORIGINS=https://tvoj-sajt.vercel.app
# CHROMA_PATH=/data/chroma   (apsolutna putanja u kontejneru, vidi DEPLOY.md)

# Optional: set a strong random secret to allow POST /admin/ingest from outside localhost.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# INGEST_SECRET=

# GitHub Webhook secret for auto-ingest on push (POST /webhook/github).
# 1. Generate: python -c "import secrets; print(secrets.token_hex(32))"
# 2. Set here AND in GitHub repo → Settings → Webhooks → Secret
# GITHUB_WEBHOOK_SECRET=


# --- Netlify (opciono) — koristi jedan od ova dva (isti personal access token):
# NETLIFY_ACCESS_TOKEN=   (eksplicitno ime u ovom projektu)
# NETLIFY_AUTH_TOKEN=     (isti token — Netlify CLI ga ovako očekuje)
NETLIFY_ACCESS_TOKEN=
NETLIFY_AUTH_TOKEN=